<style>
  /* Centering the form */
  .container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    padding: 20px;
  }

  .form-wrapper {
    width: 50%;
    max-width: 500px;
    padding: 20px;
    background: #f9f9f9;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    overflow-y: auto;
    max-height: 90vh; /* Allow scrolling if needed */
  }

  /* Form heading */
  h2, h3 {
    text-align: center;
    margin-bottom: 15px;
    color: #333;
  }

  p.text-danger {
    text-align: center;
    font-size: 14px;
    color: red;
  }

  /* Form field styling */
  .form-group {
    margin-bottom: 15px;
  }

  label {
    display: block;
    font-weight: bold;
    margin-bottom: 5px;
  }

  input[type="text"],
  input[type="email"],
  input[type="password"] {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 16px;
  }

  small {
    font-size: 12px;
    color: #666;
  }

  /* Buttons */
  .btn {
    display: block;
    width: 100%;
    padding: 10px;
    border: none;
    border-radius: 5px;
    font-size: 16px;
    cursor: pointer;
    margin-top: 10px;
  }

  .btn-primary {
    background: #007bff;
    color: white;
  }

  .btn-primary:hover {
    background: #0056b3;
  }

  .btn-danger {
    background: #dc3545;
    color: white;
  }

  .btn-danger:hover {
    background: #a71d2a;
  }

  .btn-secondary {
    background: #6c757d;
    color: white;
  }

  .btn-secondary:hover {
    background: #545b62;
  }

  /* Confirmation alert */
  .alert {
    padding: 10px;
    background: #ffeb3b;
    border-radius: 5px;
    margin-bottom: 15px;
    text-align: center;
    font-size: 14px;
  }
</style>

<div class="container">
  <div class="form-wrapper">
    <h2><%= resource_name.to_s.humanize %></h2>
    
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      
      <div class="form-group">
        <%= f.label :first_name %>
        <%= f.text_field :first_name %>
      </div>

      <div class="form-group">
        <%= f.label :last_name %>
        <%= f.text_field :last_name %>
      </div>

      <div class="form-group">
        <%= f.label :role %>
        <%= f.text_field :role, readonly: true %>
      </div>

      <div class="form-group">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", readonly: true%>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="alert">Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="form-group">
        <%= f.label :password %> <i>(leave blank if you don't want to change it)</i>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <% if @minimum_password_length %>
          <small><%= @minimum_password_length %> characters minimum</small>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="form-group">
        <%= f.label :current_password %> <i>(we need your current password to confirm your changes)</i>
        <%= f.password_field :current_password, autocomplete: "current-password" %>
      </div>

      <div class="form-group">
        <%= f.label :mobile_number %>
        <%= f.text_field :mobile_number %>
      </div>

      <div class="form-group">
        <%= f.label :address %>
        <%= f.text_field :address %>
      </div>

      <%= f.submit "Update", class: "btn btn-primary" %>
    <% end %>

    <h3>Cancel my account</h3>
    <p class="text-danger">Unhappy? You can delete your account below.</p>

    <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?" }, method: :delete, class: "btn btn-danger" %>

    <%= link_to "Back", :back, class: "btn btn-secondary" %>
  </div>
</div>
